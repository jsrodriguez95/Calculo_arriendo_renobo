    O.nomEx=(O.base*O.aT+C.aporte+C.ncom*O.base)/(O.aT-O.ag);O.nom=Math.round(O.nomEx/1000)*1000;
    O.liAdj=isFinite(O.li)?Math.round(O.li*O.nomEx/O.base/1000)*1000:O.nom;
    O.dpol=C.causal&&C.causal!=="Sin descuento"?(C.dpct||0)/100:0;O.causal=O.dpol>0?C.causal:"";
    O.pactado=C.pactado!=null?C.pactado:Math.round(O.nom*(1-O.dpol)/1000)*1000;
    const dif=O.nom-O.pactado;O.subs=dif>0&&(O.dpol>0||O.pactado<O.liAdj);O.sinCausal=O.subs&&O.dpol===0;
    O.subsMes=O.subs?dif:0;O.mesesPago=Math.max(0,(C.plazo||0)-(C.gracia||0));O.subsTot=O.subsMes*O.mesesPago;O.dReal=O.nom>0?dif/O.nom:0;
  }else if(T.unidad!=="mes"&&isFinite(O.base)){O.nom=Math.round(O.base/100)*100;O.pactado=O.nom;O.total=O.nom*C.dias}
  O.warn=[];
  if(T.unidad==="mes"&&isFinite(O.base)){
    if(!(C.plazo>0))O.warn.push(["bad","Ingrese el plazo del contrato."]);
    else if((C.gracia||0)>=C.plazo)O.warn.push(["bad","Los meses de gracia deben ser menores que el plazo."]);
    else if(isFinite(O.nomEx)&&O.nomEx/O.base>1.25)O.warn.push(["warn",`El canon nominal supera en ${fmtP(O.nomEx/O.base-1,0)} al canon base: la gracia, el aporte y los costos se recuperan en solo ${C.plazo-(C.gracia||0)} meses de pago. Considere un plazo mayor, menos gracia o pactar el aporte por separado.`]);
    if(C.k>0.03)O.warn.push(["warn",`Revise la tasa de oportunidad: ${fmtP(C.k)} mensual equivale a ${fmtP(Math.pow(1+C.k,12)-1,0)} anual.`]);
  }
