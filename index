    const comb=U.w*U.ipc[y-1]+(1-U.w)*U.mkt[y-1];const tope=T.ley820?U.ipc[y-1]:U.tope;const aj=Math.min(comb+U.p,tope);
    v=Math.round(v*(1+aj));O.years.push({y,comb,aj,v})}
  return O;
}

