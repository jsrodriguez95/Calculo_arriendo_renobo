<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Calculadora de cánones RenoBo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout: ficha técnica de avalúo — barra de resumen fija; selector de tipología; pasos del procedimiento en orden; tablas de trabajo con scroll propio */
:root{
  --bg:#F4F5F1; --surface:#FFFFFF; --surface-2:#EEF0EA; --ink:#1C2430; --muted:#5E6873; --line:#D6DAD2;
  --accent:#2E6A55; --accent-soft:#DCEBE4; --input:#FFF8E1; --input-line:#E2C766;
  --ok:#2E7D4F; --ok-soft:#E1F1E7; --warn:#A86414; --warn-soft:#FBEBD3; --bad:#B23A32; --bad-soft:#F7DEDB;
  --raw:#8A94A0; --homog:#2E6A55; --band:rgba(46,106,85,.14);
  --f-display:"Archivo","Helvetica Neue",Arial,sans-serif;
  --f-body:"IBM Plex Sans","Segoe UI",Arial,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#13181D; --surface:#1B2229; --surface-2:#222B33; --ink:#E6EAE6; --muted:#9AA5AE; --line:#33404A;
  --accent:#6FC3A2; --accent-soft:#1F3A31; --input:#2C2A1E; --input-line:#7A6A2A;
  --ok:#74C995; --ok-soft:#1D3527; --warn:#E3A55A; --warn-soft:#3A2D1B; --bad:#EE8A80; --bad-soft:#3D2220;
  --raw:#7D8893; --homog:#6FC3A2; --band:rgba(111,195,162,.16); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#13181D; --surface:#1B2229; --surface-2:#222B33; --ink:#E6EAE6; --muted:#9AA5AE; --line:#33404A;
  --accent:#6FC3A2; --accent-soft:#1F3A31; --input:#2C2A1E; --input-line:#7A6A2A;
  --ok:#74C995; --ok-soft:#1D3527; --warn:#E3A55A; --warn-soft:#3A2D1B; --bad:#EE8A80; --bad-soft:#3D2220;
  --raw:#7D8893; --homog:#6FC3A2; --band:rgba(111,195,162,.16); color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.5;margin:0}
.wrap{max-width:1180px;margin:0 auto;padding-inline:20px;padding-block:0 64px}
h1,h2,h3{font-family:var(--f-display);text-wrap:balance;margin:0}
h1{font-size:1.65rem;font-weight:700;letter-spacing:-.01em}
h2{font-size:1.25rem;font-weight:700}
h3{font-size:1rem;font-weight:600}
p{margin:0}
.mono,td.n{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.muted{color:var(--muted)} .small{font-size:.82rem}
.eyebrow{font-size:.72rem;letter-spacing:.09em;text-transform:uppercase;color:var(--muted);font-weight:600}
header.top{padding-block:28px 10px;display:flex;flex-wrap:wrap;gap:12px 24px;align-items:flex-end;justify-content:space-between}
.tag{display:inline-block;font-size:.75rem;padding:2px 8px;border-radius:999px;background:var(--warn-soft);color:var(--warn);font-weight:600}
.summary{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);border-bottom:1px solid var(--line);padding-block:10px}
.summary .row{display:flex;flex-wrap:wrap;gap:10px 28px;align-items:center}
.kpi{display:flex;flex-direction:column;min-width:0}
.kpi .v{font-family:var(--f-mono);font-size:1.12rem;font-weight:500}
.pill{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:999px;font-size:.8rem;font-weight:600;white-space:nowrap}
.pill.ok{background:var(--ok-soft);color:var(--ok)}.pill.warn{background:var(--warn-soft);color:var(--warn)}.pill.bad{background:var(--bad-soft);color:var(--bad)}.pill.neutral{background:var(--surface-2);color:var(--muted)}
nav.steps{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
nav.steps a{font-size:.8rem;color:var(--ink);text-decoration:none;padding:3px 10px;border:1px solid var(--line);border-radius:999px;background:var(--surface)}
nav.steps a:hover,nav.steps a:focus-visible{border-color:var(--accent);color:var(--accent);outline:none}

/* selector de tipología */
.tipos{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px;margin-top:6px}
.tipo{display:flex;flex-direction:column;gap:2px;text-align:left;padding:10px 12px;border:1px solid var(--line);border-radius:6px;background:var(--surface);cursor:pointer;min-width:0}
.tipo b{font-family:var(--f-display);font-size:.95rem;font-weight:600}
.tipo span{font-size:.75rem;color:var(--muted)}
.tipo[aria-pressed="true"]{border-color:var(--accent);background:var(--accent-soft)}
.tipo[aria-pressed="true"] span{color:var(--accent)}

section.step{margin-top:34px;scroll-margin-top:130px}
.step-head{display:flex;gap:14px;align-items:baseline;margin-bottom:10px;flex-wrap:wrap}
.step-head .idx{font-family:var(--f-mono);font-size:.85rem;color:var(--accent);font-weight:500}
.lead{color:var(--muted);max-width:72ch;margin-bottom:14px}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:16px;min-width:0}
.grid{display:grid;gap:12px}
.g4{grid-template-columns:repeat(auto-fit,minmax(170px,1fr))}
.g3{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
.cols{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:16px}
@media (max-width:860px){.cols{grid-template-columns:minmax(0,1fr)}}
label.f{display:flex;flex-direction:column;gap:4px;font-size:.82rem;color:var(--muted);min-width:0}
label.chk{display:flex;gap:8px;align-items:center;font-size:.86rem;color:var(--ink)}
input,select,textarea{font:inherit;font-size:.9rem;color:var(--ink);background:var(--input);border:1px solid var(--input-line);border-radius:4px;padding:6px 8px;min-width:0;width:100%}
textarea{font-family:var(--f-mono);font-size:.8rem;min-height:110px;resize:vertical}
input[type=number]{font-family:var(--f-mono);font-variant-numeric:tabular-nums;text-align:right}
input[type=checkbox]{width:auto;accent-color:var(--accent)}
input:focus-visible,select:focus-visible,textarea:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
button{font:inherit;font-size:.85rem;cursor:pointer;border-radius:4px;border:1px solid var(--line);background:var(--surface);color:var(--ink);padding:6px 12px}
button.primary{background:var(--accent);border-color:var(--accent);color:var(--surface)}
button.ghost{border-color:transparent;background:transparent;color:var(--muted);padding:2px 6px}
button:hover{border-color:var(--accent)}
.btns{display:flex;gap:8px;flex-wrap:wrap;align-items:center}

/* correctores */
.corr-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px}
.corr{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:12px 14px;display:flex;flex-direction:column;gap:6px;min-width:0}
.corr .top{display:flex;justify-content:space-between;gap:8px;align-items:baseline}
.corr .fx{font-family:var(--f-mono);font-size:1.25rem;color:var(--accent)}
.corr .rule{font-family:var(--f-mono);font-size:.74rem;color:var(--muted)}
.corr .row2{display:flex;gap:10px;align-items:center}
.corr .row2 input{width:90px}
.lvl{white-space:nowrap;flex:none;font-size:.68rem;font-weight:700;letter-spacing:.06em;padding:1px 6px;border-radius:3px;background:var(--warn-soft);color:var(--warn)}
.matrix td,.matrix th{text-align:center}
.matrix td:first-child,.matrix th:first-child{text-align:left}
.matrix tr.cur td{background:var(--accent-soft)}

.tbl-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:6px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:.84rem}
th{font-weight:600;text-align:left;color:var(--muted);font-size:.74rem;padding:8px;border-bottom:1px solid var(--line);background:var(--surface-2);white-space:nowrap}
td{padding:5px 8px;border-bottom:1px solid var(--line);vertical-align:middle;white-space:nowrap}
td.n{text-align:right}
tr:last-child td{border-bottom:none}
tr.off td{color:var(--muted)}
.tbl-inputs input,.tbl-inputs select{padding:3px 5px;font-size:.82rem}
.tbl-inputs input[type=number]{width:92px}
.tbl-inputs select{width:auto;min-width:92px}
.tbl-inputs input.w-s{width:64px}
.tbl-inputs input.w-id{width:58px;text-align:left;font-family:var(--f-mono)}
.fac{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.fac.up{color:var(--ok);font-weight:500}.fac.dn{color:var(--bad);font-weight:500}.fac.one{color:var(--muted);opacity:.6}
.empty{padding:22px;text-align:center;color:var(--muted)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:6px;overflow:hidden}
.stats.s2{grid-template-columns:repeat(2,minmax(0,1fr))}
.stats>div{background:var(--surface);padding:12px 14px;min-width:0}
.stats .v{font-family:var(--f-mono);font-size:1.05rem;margin-top:2px}
.big{font-family:var(--f-mono);font-size:1.7rem;font-weight:500;color:var(--accent)}
.checks{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.formula{font-family:var(--f-mono);font-size:.82rem;background:var(--surface-2);border-radius:4px;padding:8px 10px;overflow-x:auto;white-space:nowrap}
.chart-wrap{overflow-x:auto}
svg text{font-family:var(--f-mono);font-size:11px;fill:var(--muted)}
svg .lbl{fill:var(--ink)}
details.box{margin-top:12px;border:1px solid var(--line);border-radius:6px;background:var(--surface);padding:0 14px}
details.box summary{cursor:pointer;font-weight:600;padding:10px 0}
details.box[open]{padding-bottom:14px}
pre.memo{font-family:var(--f-mono);font-size:.8rem;background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:14px;white-space:pre-wrap;margin:0;max-height:440px;overflow:auto}
.legend{display:flex;flex-wrap:wrap;gap:14px;font-size:.78rem;color:var(--muted);margin-top:8px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px;vertical-align:-1px}
.note{font-size:.8rem;color:var(--muted);margin-top:10px;max-width:80ch}
</style>
</head>
<body>


<div class="summary">
  <div class="wrap" style="padding-block:0">
    <div class="row">
      <div class="kpi"><span class="eyebrow">Tipología</span><span class="v" id="k-tipo" style="font-family:var(--f-display);font-weight:600">—</span></div>
      <div class="kpi"><span class="eyebrow" id="k-base-l">Canon base</span><span class="v" id="k-base">—</span></div>
      <div class="kpi"><span class="eyebrow">Canon a pactar</span><span class="v" id="k-nom">—</span></div>
      <div class="kpi" id="k-n-box"><span class="eyebrow">Comparables usados</span><span class="v" id="k-n">—</span></div>
      <span id="k-res" class="pill neutral">—</span>
    </div>
    <nav class="steps" aria-label="Pasos">
      <a href="#tipologia">Tipología</a><a href="#activo">Activo</a><a href="#correctores">Correctores</a><a href="#comparables" class="comp-only">Comparables</a>
      <a href="#homog" class="comp-only">Homogeneización</a><a href="#canon">Canon base</a><a href="#contrato">Contrato</a><a href="#actualizacion">Actualización</a><a href="#memoria">Memoria</a>
    </nav>
  </div>
</div>

<div class="wrap">
  <header class="top">
    <div>
      <p class="eyebrow">Empresa de Renovación y Desarrollo Urbano de Bogotá · Herramienta de cálculo</p>
      <h1>Calculadora de cánones de arrendamiento</h1>
      <p class="muted small" style="margin-top:4px">Elija la tipología, describa el activo, ingrese sus comparables y obtenga el canon con la tabla de parámetros vigente.</p>
    </div>
    <div class="btns"><span class="tag">Parámetros ilustrativos · versión 2027-1</span><button type="button" id="btn-limpiar">Limpiar campos</button><button type="button" id="btn-ej-all">Cargar ejemplo</button><span class="small muted" id="limpiar-msg" role="status"></span></div>
  </header>

  <section class="step" id="tipologia" style="margin-top:10px">
    <div class="step-head"><span class="idx">Paso 1</span><h2>Tipología del activo</h2></div>
    <p class="lead">Cada tipología tiene su propio mercado, su propio método de cálculo y sus propios correctores.</p>
    <div class="tipos" id="tipos" role="group" aria-label="Tipología"></div>
  </section>

  <section class="step" id="activo">
    <div class="step-head"><span class="idx">Paso 2</span><h2>Ficha del activo</h2></div>
    <p class="lead" id="activo-lead">Los atributos del activo son el punto de referencia: cada comparable se ajusta para parecerse a él.</p>
    <div class="panel"><div class="grid g4" id="activo-form"></div></div>
  </section>

  <section class="step" id="correctores">
    <div class="step-head"><span class="idx">Paso 3</span><h2>Correctores de la tipología</h2></div>
    <p class="lead" id="corr-lead"></p>
    <div class="corr-grid" id="corr-cards"></div>
    <details class="box" id="matrix-box">
      <summary>Comparar los correctores de todas las tipologías</summary>
      <p class="note" style="margin:0 0 10px">Factor que se aplica a un comparable que <b>no</b> tiene el atributo cuando el activo sí lo tiene. “—” indica que el atributo no aplica a esa tipología.</p>
      <div class="tbl-wrap"><table class="matrix" id="matrix"></table></div>
    </details>
  </section>

  <section class="step comp-only" id="comparables">
    <div class="step-head"><span class="idx">Paso 4</span><h2>Comparables</h2></div>
    <p class="lead">Ingrese los comparables uno a uno o péguelos desde Excel. Un registro se usa si su uso es compatible, está dentro de la zona de influencia, tiene la antigüedad y el área admitidas, y no es atípico.</p>
    <div class="btns" style="margin-bottom:10px">
      <button type="button" class="primary" id="btn-add">Agregar comparable</button>
      <button type="button" id="btn-paste-toggle" aria-expanded="false" aria-controls="paste-box">Pegar desde Excel</button>
      <button type="button" id="btn-example">Cargar ejemplo</button>
      <button type="button" id="btn-clear">Vaciar tabla</button>
      <span class="small muted" id="data-status"></span>
    </div>
    <div class="panel" id="paste-box" hidden style="margin-bottom:12px">
      <p class="small muted">Copie filas desde Excel con las columnas en este orden (Sí/No en las casillas). La fila de encabezados es opcional.</p>
      <div class="formula" id="paste-cols" style="margin:8px 0"></div>
      <textarea id="paste-area" aria-label="Filas pegadas desde Excel" placeholder="Pegue aquí las filas copiadas de Excel"></textarea>
      <div class="btns" style="margin-top:8px"><button type="button" class="primary" id="btn-import">Importar filas</button><button type="button" id="btn-copy-head">Copiar encabezados</button><span class="small muted" id="paste-msg" role="status"></span></div>
    </div>
    <div id="aviso-activo" class="panel" hidden style="margin-bottom:10px;border-color:var(--warn);background:var(--warn-soft);color:var(--warn)"><b>Falta el área del activo.</b> Los comparables se seleccionan y homogeneizan frente al activo: complete su área y atributos en el <a href="#activo" style="color:inherit">paso 2</a>.</div>
    <div class="tbl-wrap"><table class="tbl-inputs" id="t-comp"><thead></thead><tbody></tbody></table></div>
    <p class="small muted" id="iqr-txt" style="margin-top:8px"></p>
  </section>

  <section class="step comp-only" id="homog">
    <div class="step-head"><span class="idx">Paso 5</span><h2>Homogeneización</h2></div>
    <p class="lead">Cada factor lleva el comparable a las condiciones del activo: mayor que 1 si el comparable es inferior en ese atributo, menor que 1 si es superior. Los factores se multiplican; se descarta el comparable que supera los límites de ajuste neto o bruto.</p>
    <div class="tbl-wrap"><table id="t-hom"><thead></thead><tbody></tbody></table></div>
  </section>

  <section class="step" id="canon">
    <div class="step-head"><span class="idx" id="canon-idx">Paso 6</span><h2 id="canon-h">Canon base</h2></div>
    <p class="lead" id="canon-lead"></p>
    <div id="canon-comp" class="cols">
      <div class="panel">
        <p class="eyebrow" id="c-base-l">Canon base mensual</p>
        <p class="big" id="c-base">—</p>
        <p class="small muted" id="c-ic">—</p>
        <div class="checks" id="c-checks"></div>
        <div class="stats s2" style="margin-top:14px">
          <div><span class="eyebrow">Media por m²</span><div class="v" id="c-media">—</div></div>
          <div><span class="eyebrow">Mediana por m²</span><div class="v" id="c-med">—</div></div>
          <div><span class="eyebrow">Desv. estándar</span><div class="v" id="c-sd">—</div></div>
          <div><span class="eyebrow">Coef. de variación</span><div class="v" id="c-cv">—</div></div>
        </div>
      </div>
      <div class="panel">
        <h3>Del valor observado al valor homogeneizado</h3>
        <p class="small muted" style="margin-top:2px">Cada fila es un comparable elegible. La banda es el intervalo de confianza del 90 % de la media.</p>
        <div class="chart-wrap"><svg id="chart" role="img" aria-label="Valor por m² de cada comparable antes y después de homogeneizar"></svg></div>
        <div class="legend"><span><i style="background:var(--raw)"></i>Observado</span><span><i style="background:var(--homog)"></i>Homogeneizado</span><span><i style="background:var(--bad)"></i>Descartado por límites</span></div>
      </div>
    </div>
    <div id="canon-cap" class="cols" hidden>
      <div class="panel"><div class="grid g3">
        <label class="f">Valor comercial del activo, según avalúo ($)<input id="cap-v" type="number" step="1000000"></label>
        <label class="f">Tasa de rentabilidad mensual de la tipología (%)<input id="cap-r" type="number" step="0.05"></label>
      </div>
      <p class="formula" style="margin-top:12px">C_base = V × r</p>
      <p class="note">La tasa es la mediana de la razón canon / valor de inmuebles similares, calibrada en el ejercicio anual. El valor no puede provenir de capitalizar rentas del mismo activo.</p></div>
      <div class="panel"><p class="eyebrow">Canon base mensual</p><p class="big" id="cap-out">—</p><p class="small muted" id="cap-txt"></p></div>
    </div>
    <div id="canon-rep" class="cols" hidden>
      <div class="panel"><div class="grid g3">
        <label class="f">Valor de reposición, VR ($)<input id="rep-vr" type="number" step="100000"></label>
        <label class="f">Valor residual (% de VR)<input id="rep-s" type="number" step="5"></label>
        <label class="f">Vida útil (años)<input id="rep-n" type="number" step="1"></label>
        <label class="f">Edad actual (años)<input id="rep-edad" type="number" step="1"></label>
        <label class="f">Costo de oportunidad anual, i (%)<input id="rep-i" type="number" step="0.5"></label>
        <label class="f">Mantenimiento anual (% de VR)<input id="rep-m" type="number" step="0.5"></label>
      </div>
      <p class="formula" style="margin-top:12px">C_mes = [VR·(1 − s)/n + i·VD + m·VR] / 12</p></div>
      <div class="panel"><p class="eyebrow">Canon base mensual</p><p class="big" id="rep-out">—</p><div class="stats" style="margin-top:12px">
        <div><span class="eyebrow">Depreciación anual</span><div class="v" id="rep-dep">—</div></div>
        <div><span class="eyebrow">Valor depreciado, VD</span><div class="v" id="rep-vd">—</div></div>
        <div><span class="eyebrow">Costo de capital anual</span><div class="v" id="rep-cap">—</div></div>
        <div><span class="eyebrow">Mantenimiento anual</span><div class="v" id="rep-man">—</div></div></div></div>
    </div>
  </section>

  <section class="step" id="contrato">
    <div class="step-head"><span class="idx" id="contrato-idx">Paso 7</span><h2>Contrato: renta efectiva y descuentos</h2></div>
    <div id="contrato-mes">
      <p class="lead">Si el contrato tiene meses de gracia, aportes de RenoBo o costos de transacción, el canon nominal sube para que RenoBo reciba, en valor presente, lo mismo que cobrando el canon base todos los meses.</p>
      <div class="cols">
        <div class="panel">
          <div class="grid g3">
            <label class="f">Plazo (meses)<input id="r-plazo" type="number" min="1" step="1"></label>
            <label class="f">Meses de gracia<input id="r-gracia" type="number" min="0" step="1"></label>
            <label class="f">Tasa de oportunidad mensual (%)<input id="r-k" type="number" step="0.1"></label>
            <label class="f">Aporte de RenoBo ($)<input id="r-aporte" type="number" step="100000"></label>
            <label class="f">Costos de transacción (n.º de cánones)<input id="r-ncom" type="number" step="0.5"></label>
          </div>
          <p class="formula" style="margin-top:14px">C_nom = (C_base · a(T) + aporte + costos) / (a(T) − a(g)),  a(n) = (1 − (1+k)^−n) / k</p>
          <div class="checks" id="r-warn"></div>
        </div>
        <div class="panel">
          <p class="eyebrow">Canon nominal de mercado (redondeado a miles)</p>
          <p class="big" id="r-nom" style="font-size:1.35rem">—</p>
          <p class="small muted" id="r-exact">—</p>
          <h3 style="margin-top:16px">Descuento de política (Módulo 5)</h3>
