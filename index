  if(isFinite(O.li)){const a=x(O.li/A.area),b=x(O.ls/A.area);s+=`<rect x="${a}" y="${top-8}" width="${Math.max(b-a,1)}" height="${H-bot-top+12}" fill="var(--band)"/>`}
