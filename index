    O.years.map(Y=>Y.y===1?["1","","","","",p$(Y.v)]:[String(Y.y),pP(s.act.ipc[Y.y-1]),pP(s.act.mkt[Y.y-1]),pP(Y.comb),pP(Y.aj),p$(Y.v)]),
    {styles:{halign:"right"},columnStyles:{0:{halign:"center"}}});
  note(T.ley820?"Vivienda: reajuste limitado al IPC del año anterior (Ley 820 de 2003).":`Índice combinado = ${pN(s.act.w,2)} x IPC + ${pN(1-s.act.w,2)} x mercado; reajuste = mín(índice + ${pP(s.act.p)}; ${pP(s.act.tope)}). Revisión a mercado cada tres años.`);
  // firmas
  if(y>240){doc.addPage();y=20}
  sec((nS+2)+". Responsables");y+=12;
  [["Calculó",M],["Revisó",M+62],["Aprobó",M+124]].forEach(([t,x])=>{doc.setDrawColor(...mut);doc.line(x,y,x+54,y);doc.setFontSize(8);doc.setTextColor(...mut);doc.text(t+" (nombre, cargo y fecha)",x,y+4)});
  // pie
  const np=doc.getNumberOfPages();
  for(let i=1;i<=np;i++){doc.setPage(i);doc.setFontSize(7.5);doc.setTextColor(...mut);doc.text(PDFTXT("Memoria de cálculo · "+(s.codigo||"activo")+" · "+fecha),M,290);doc.text("Página "+i+" de "+np,W-M,290,{align:"right"})}
  const name=("Memoria_"+(s.codigo||"activo")+"_"+fecha).replace(/[^\w\-]+/g,"_")+".pdf";
  return {name,doc};
}
(async()=>{
  const btn=$("btn-pdf"),msg=$("copy-msg");let dl=null;
  try{dl=await (window.claude&&window.claude.use?window.claude.use("downloads"):null)}catch(e){dl=null}
  if(!window.jspdf||!window.jspdf.jsPDF||!window.jspdf.jsPDF.API.autoTable){btn.hidden=true;msg.textContent="No se pudo cargar el generador de PDF; use “Copiar resumen”.";return}
  if(!dl){btn.onclick=()=>{try{const {name,doc}=memoriaPDF();doc.save(name);msg.textContent="Memoria descargada: "+name}catch(e){msg.textContent="No se pudo generar el PDF."}};return}
  btn.onclick=async()=>{btn.disabled=true;msg.textContent="Preparando el PDF…";
    try{const {name,doc}=memoriaPDF();await dl.save({filename:name,data:doc.output("arraybuffer")});msg.textContent="Memoria descargada: "+name}
    catch(e){const c=e&&e.code;msg.textContent=c==="declined"?"Descarga cancelada.":c==="rate_limited"?"Hay una descarga pendiente; inténtelo de nuevo en unos segundos.":"No se pudo generar el PDF ("+(c||(e&&e.message)||"error")+")."}
    finally{btn.disabled=false}};
})();
drawAll();
})();
</script>

