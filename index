    if(Math.abs(x1-x0)>6){const d=x1>x0?-1:1;s+=`<line x1="${x0}" x2="${x1+d*5}" y1="${y}" y2="${y}" stroke="${col}" stroke-width="1.4"/><path d="M${x1+d*5},${y-4} L${x1},${y} L${x1+d*5},${y+4}" fill="none" stroke="${col}" stroke-width="1.4"/>`}
    s+=`<circle cx="${x0}" cy="${y}" r="4.5" fill="var(--surface)" stroke="var(--raw)" stroke-width="1.6"/><circle cx="${x1}" cy="${y}" r="4.5" fill="${col}"/>`});
  s+=`<text x="${W-right}" y="${H-4}" text-anchor="end">${O.T.unidad==="día"?"Tarifa por m² ($/m²/día)":"Canon por m² ($/m²/mes)"}</text>`;svg.innerHTML=s;
}
