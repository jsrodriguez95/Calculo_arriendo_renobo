  if(!rows.length){svg.innerHTML=`<text x="${W/2}" y="${H/2}" text-anchor="middle">Sin comparables elegibles</text>`;return}
  const vals=rows.flatMap(r=>[r.m2,r.h]).concat(isFinite(O.li)?[O.li/A.area,O.ls/A.area]:[]);
  let mn=Math.min(...vals),mx=Math.max(...vals);const pad=(mx-mn)*0.08||mx*0.05;mn-=pad;mx+=pad;
  const raw=(mx-mn)/6,mag=Math.pow(10,Math.floor(Math.log10(raw))),step=[1,2,2.5,5,10].map(m=>m*mag).find(s=>s>=raw);
